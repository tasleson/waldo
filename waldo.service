[Unit]
Description=Screen lock/unlock webhook notifier
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.cargo/bin/waldo --config %h/.config/waldo/config.toml
Restart=on-failure
RestartSec=5
# Allow time to deliver the "offline" webhook on logout/reboot, but do
# not hold up session teardown if the network is already gone.
TimeoutStopSec=15

[Install]
WantedBy=graphical-session.target
